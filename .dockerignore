# Dependencies / build output (rebuilt inside image)
node_modules
.next
dist-electron

# VCS / editor
.git
.gitignore

# Desktop-only (not used in web deployment)
electron
scripts

# Local runtime state (provided via volumes on the server)
.puppeteer_data
.puppeteer_session
data
*.log

# User media (provided via volumes on the server)
public/audio
public/music
public/recordings
public/exports

# Secrets - never bake into the image
.env
.env.*
!.env.example
deploy/.htpasswd

# Docs
*.md
