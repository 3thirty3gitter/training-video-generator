# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------
# Firestore (optional) — replaces local project_data.json persistence
# Required for cloud deployments where the filesystem is ephemeral
# (e.g. Cloud Run, Railway, Render)
#
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Enable Firestore Database (Native mode)
# 3. Go to Project Settings → Service Accounts → Generate new private key
# 4. Copy values from the downloaded JSON into the vars below
# -----------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value — keep the \n escape sequences as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
